{
  "version": 2,
  "name": "quantumbranding-ai",
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
{
      "src": "/",
      "has": [{"type": "host", "value": "app.quantumbranding.ai"}],
      "dest": "/qb-branidos-hub.html"
    },
        {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/os",
      "dest": "/qb-branidos-hub.html"
    },
    {
      "src": "/scan",
      "dest": "/signal-scan.html"
    },
    {
      "src": "/panel",
      "dest": "/predictive-panel..html"
    },
    {
      "src": "/war-room",
      "dest": "/war-room.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/atelier",
      "dest": "/atelier.html"
    },
    {
      "src": "/tools",
      "dest": "/tools.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://fonts.googleapis.com https://cdnjs.cloudflare.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://quantumbranding.ai https://app.quantumbranding.ai https://a.klaviyo.com https://manage.kmail-lists.com https://yushbxjwfhuokaezoioe.supabase.co https://api.stripe.com https://billing.stripe.com; img-src 'self' data: https:; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://billing.stripe.com https://vitals.vercel-insights.com; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(qb-cloud|qb-gate)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
