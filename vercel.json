{
  "version": 2,
  "name": "quantumbranding-ai",
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/",
      "has": [{"type": "host", "value": "app.quantumbranding.ai"}],
      "dest": "/foundation.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/_archive(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/os",
      "status": 301,
      "headers": {"Location": "/foundation"}
    },
    {
      "src": "/hub",
      "status": 301,
      "headers": {"Location": "/foundation"}
    },
    {
      "src": "/qb-branidos-hub(\\.html)?",
      "status": 301,
      "headers": {"Location": "/foundation"}
    },
    {
      "src": "/dashboard(\\.html)?",
      "status": 301,
      "headers": {"Location": "/foundation"}
    },
    {
      "src": "/journey-guide(\\.html)?",
      "status": 410,
      "headers": {"Content-Type": "text/plain"}
    },
    {
      "src": "/foundation",
      "dest": "/foundation.html"
    },
    {
      "src": "/paywall",
      "dest": "/paywall.html"
    },
    {
      "src": "/account",
      "dest": "/account.html"
    },
    {
      "src": "/scan",
      "dest": "/signal-scan.html"
    },
    {
      "src": "/panel",
      "dest": "/predictive-panel..html"
    },
    {
      "src": "/war-room",
      "dest": "/war-room.html"
    },
    {
      "src": "/atelier",
      "dest": "/atelier.html"
    },
    {
      "src": "/tools",
      "dest": "/tools.html"
    },
    {
      "src": "/agents",
      "dest": "/agents.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/api/artifacts/([0-9a-fA-F-]{36})/regenerate",
      "dest": "/api/artifacts/[id]/regenerate"
    },
    {
      "src": "/api/artifacts/([0-9a-fA-F-]{36})",
      "dest": "/api/artifacts/[id]"
    },
    {
      "src": "/api/agent-runs/([0-9a-fA-F-]{36})/replay",
      "dest": "/api/agent-runs/[id]/replay"
    },
    {
      "src": "/artifact/([0-9a-fA-F-]{36})",
      "dest": "/artifact.html?id=$1"
    },
    {
      "src": "/artifact",
      "dest": "/artifact.html"
    },
    {
      "src": "/qbp",
      "dest": "/qbp.html"
    },
    {
      "src": "/archive",
      "dest": "/archive.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://fonts.googleapis.com https://cdnjs.cloudflare.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://quantumbranding.ai https://app.quantumbranding.ai https://yushbxjwfhuokaezoioe.supabase.co https://api.stripe.com https://billing.stripe.com; img-src 'self' data: https:; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://billing.stripe.com https://vitals.vercel-insights.com; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(qb-cloud|qb-gate)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
