{
  "name": "qb-branos",
  "version": "1.0.0",
  "private": true,
  "description": "BrandOS \u2014 static site + Vercel Functions (Edge + Node serverless). Build step is null; this manifest exists so Vercel installs the runtime deps below. type:module makes the Node runtime treat the ESM api/ files as ESM natively (chapter-3 step 5 runtime migration).",
  "type": "module",
  "license": "UNLICENSED",
  "dependencies": {
    "@vercel/functions": "^2.2.13",
    "@vercel/og": "^0.6.4"
  },
  "scripts": {
    "test:casing": "node tests/brand-casing/casing-audit.mjs",
    "test:casing:prod": "node tests/brand-casing/casing-audit.mjs --base https://quantumbranding.ai",
    "seo:sitemap": "node scripts/gen-sitemap.mjs",
    "seo:audit": "node tests/seo-bing/bing-audit.mjs",
    "seo:audit:prod": "node tests/seo-bing/bing-audit.mjs --base https://quantumbranding.ai",
    "seo:indexnow": "node scripts/seo/indexnow-submit.mjs --changed",
    "seo:indexnow:all": "node scripts/seo/indexnow-submit.mjs --all",
    "platform:build": "node scripts/platform/build.mjs",
    "platform:render": "node scripts/platform/render.mjs",
    "test:platform": "node tests/platform/platform-render.mjs",
    "test:one-price": "node tests/one-price/one-price.mjs",
    "test:operator-only": "node tests/operator-only/operator-only.mjs",
    "test:open-questions": "node tests/open-questions/open-questions.mjs",
    "test:model-routing": "node tests/model-routing/model-routing.mjs"
  }
}
